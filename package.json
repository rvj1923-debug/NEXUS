{
  "name": "company-phone-tracker",
  "version": "1.0.5",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000",
    "build": "prisma generate && next build",
    "start": "if not defined APP_HOST (set APP_HOST=0.0.0.0) && call next start -p 5000 -H %APP_HOST%",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node --loader ts-node/esm prisma/seed.ts",
    "import:supervisors": "node scripts/import-supervisors.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@prisma/client": "^5.22.0",
    "autoprefixer": "^10.6.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "nodemailer": "^10.1.0",
    "papaparse": "^5.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
