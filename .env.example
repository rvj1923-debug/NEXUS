# Company Phone Tracker (NEXUS) - Environment Configuration Example
# Copy this file to .env and adjust values for your deployment environment.

# ==============================================================================
# 1. Core Database & Embedded PGlite Storage
# ==============================================================================

# [REQUIRED in production] PostgreSQL connection string (note: pgbouncer=true&connection_limit=1 is intentional for single-connection embedded PGlite)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/company_phone_tracker?pgbouncer=true&connection_limit=1"

# [Optional in production] Directory path for embedded PGlite PostgreSQL data files (defaults to ./postgres_data)
PG_DATA_DIR="./postgres_data"

# [Optional in production] Host address for PGlite socket server and backup/auto-heal scripts (defaults to 127.0.0.1)
PGHOST="127.0.0.1"

# [Optional in production] TCP port for PGlite PostgreSQL socket server (defaults to 5432)
PGPORT=5432

# [Optional in production] Local HTTP control port used by scripts/db-server.mjs for graceful WAL-flushed shutdown (defaults to 54320)
PG_CONTROL_PORT=54320

# ==============================================================================
# 2. Cryptographic Secrets & Session Security
# ==============================================================================

# [REQUIRED in production] Server-side HS256 JWT signing secret; must be at least 32 characters (server refuses to start in production if missing or <32 chars)
SESSION_SECRET="replace-with-at-least-32-random-hex-or-base64-characters-for-jwt-sessions"

# [REQUIRED in production] Shared secret key for unattended kiosk browser authentication via /api/kiosk/device-login; must be at least 32 characters
KIOSK_DEVICE_SECRET="replace-with-at-least-32-random-characters-for-kiosk-device-login"

# [REQUIRED in production] Unique identifier code of the provisioned KioskDevice row assigned to this terminal
KIOSK_CODE="PHONE-KIOSK-01"

# ==============================================================================
# 3. Web Server, Proxy & Timezone Settings
# ==============================================================================

# [REQUIRED in production] Runtime environment mode ("development", "production", or "test")
NODE_ENV="production"

# [Optional in production] HTTP port for the Next.js web server (defaults to 5000)
PORT=5000

# [Optional in production] Bind address for next start (defaults to "0.0.0.0"; set to "127.0.0.1" if admin UI is only accessed locally on the kiosk PC)
APP_HOST="0.0.0.0"

# [REQUIRED in production] Public base URL of the web application used for cookie security flags and email action links
NEXT_PUBLIC_APP_URL="http://localhost:5000"

# [Optional in production] Internal base URL override used by CLI verification and seed/test scripts (defaults to http://localhost:5000)
APP_URL="http://localhost:5000"

# [Optional in production] Set to "true" ONLY when running behind a trusted reverse proxy that appends X-Forwarded-For (defaults to "false")
TRUST_PROXY="false"

# [Optional in production] IANA timezone identifier for server-side custody timestamps, shift deadlines, and reports (defaults to "Asia/Manila")
APP_TIMEZONE="Asia/Manila"

# [Optional in production] Public IANA timezone override for client-side date/time formatting (defaults to APP_TIMEZONE or "Asia/Manila")
NEXT_PUBLIC_APP_TIMEZONE="Asia/Manila"

# [Optional] Deployment role of this installation (defaults to "ALL"). See AZURE_DEPLOYMENT.md.
#   ALL    = web server, database, NFC agent and Edge kiosk all on this PC (original kiosk layout)
#   SERVER = central server such as an Azure VM; NFC agents run on the kiosk PCs instead
#   KIOSK  = kiosk PC that only runs the NFC agent and Edge, pointing at KIOSK_SERVER_URL
# Set by scripts/configure-azure-server.ps1 and scripts/configure-kiosk-client.ps1.
CPT_ROLE="ALL"

# [KIOSK role only] Public HTTPS address of the central server that the kiosk browser opens
KIOSK_SERVER_URL="http://localhost:5000"

# ==============================================================================
# 4. Local NFC Hardware Reader Agent (agent/reader-agent.mjs)
# ==============================================================================

# [REQUIRED in production] Shared pairing secret required by POST /api/agent/pair to issue agent session tokens; must be at least 16 characters
AGENT_PAIRING_SECRET="replace-with-at-least-32-random-characters-for-local-nfc-agent-pairing"

# [Optional in production] Loopback bind address for the local NFC hardware agent HTTP/SSE server (defaults to "127.0.0.1")
AGENT_HOST="127.0.0.1"

# [Optional in production] TCP port for the local NFC hardware agent HTTP/SSE server (defaults to 8002)
AGENT_PORT=8002

# [Optional in production] Comma-separated list of allowed CORS origins permitted to communicate with the local NFC agent
AGENT_ALLOWED_ORIGINS="http://localhost:5000,http://127.0.0.1:5000"

# ==============================================================================
# 5. Automated Backups, Disaster Recovery & Deployment Identity
# ==============================================================================

# [REQUIRED in production] Unique deployment identifier tying backups to this installation (auto-generated into .env by auto-heal if absent)
DEPLOYMENT_ID="cpt-deploy-replace-with-unique-installation-id"

# [Optional in production] Primary directory where automated JSON.gz database snapshots and backup-status.json are stored (defaults to ./backups)
BACKUP_DIR="./backups"

# [Optional in production] Secondary off-directory or external drive path where every backup snapshot is mirrored for redundancy (defaults to C:\CPT_Backups_Mirror)
BACKUP_MIRROR_DIR="C:\\CPT_Backups_Mirror"

# [Optional in production] Polling interval in milliseconds for the continuous background backup worker (defaults to 900000 / 15 minutes)
BACKUP_INTERVAL_MS=900000

# [Optional in production] Custom path to the .env file used by scripts/auto-heal-db.mjs when persisting DEPLOYMENT_ID (defaults to ./.env)
ENV_FILE_PATH="./.env"

# ==============================================================================
# 6. SMTP Email & Overdue Escalation Notifications
# ==============================================================================

# [Optional in production] Outbound SMTP server hostname for overdue alerts and daily audit reports (can also be configured in UI settings)
SMTP_HOST="smtp.gmail.com"

# [Optional in production] Outbound SMTP server port (defaults to 587 for STARTTLS or 465 for implicit TLS)
SMTP_PORT=587

# [Optional in production] Outbound SMTP authentication username / email address
SMTP_USER=""

# [Optional in production] Outbound SMTP authentication password or Gmail App Password
SMTP_PASS=""

# [Optional in production] Sender email address and display name used in From headers (defaults to noreply@company-phone-tracker.local)
SMTP_FROM="NEXUS Custody Alert <noreply@company-phone-tracker.local>"

# [Optional in production] Fallback recipient email address when a department has no supervisor email configured
NOTIFICATION_DEFAULT_RECIPIENT="security-desk@company.com"

# [Optional in production] Default HR Department email address for unapproved overdue escalations (defaults to hr@company.com)
HR_DEPARTMENT_EMAIL="hr@company.com"
